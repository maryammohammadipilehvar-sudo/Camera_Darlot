[Unit]
Description=Sentinel Security Dashboard (port 8888)
After=network-online.target mosquitto.service security_pipeline.service
Wants=network-online.target mosquitto.service security_pipeline.service
Requires=security_pipeline.service

[Service]
Type=simple
User=quarero
WorkingDirectory=/home/quarero/Desktop/security_pipeline
Environment="PATH=/home/quarero/Desktop/security_pipeline/.venv/bin:/usr/local/cuda/bin:/usr/src/tensorrt/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/quarero/Desktop/security_pipeline/.venv/bin/python /home/quarero/Desktop/security_pipeline/dashboard_server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
