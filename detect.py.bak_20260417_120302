_alert_q: queue.Queue = queue.Queue(maxsize=200)

def _mqtt_worker(cfg):
    try:
        import paho.mqtt.client as mqtt
        client = mqtt.Client()
        client.connect(cfg["mqtt_host"], cfg["mqtt_port"], 60)
        client.loop_start()
        log.info("MQTT connected")
        while True:
            payload = _alert_q.get()
            client.publish(cfg["mqtt_topic"], json.dumps(payload), qos=1)
    except Exception as e:
        log.warning(f"MQTT unavailable ({e}) — alerts logged only")
        while True:
            payload = _alert_q.get()
            log.warning(f"ALERT {payload}")

def emit_alert(camera_id: str, kind: str, detail: dict):
    payload = {
        "camera": camera_id,
        "kind": kind,
        "ts": time.time(),
        "label": detail.get("label", kind),
        "severity": detail.get("severity", "low"),
        **detail
    }
    try:
        _alert_q.put_nowait(payload)
    except queue.Full:
        log.warning("Alert queue full — dropped")

