_COLORS = [(0,0,255),(0,255,0),(255,128,0),(0,255,255),(255,0,255)]

def _color(track_id: int):
    return _COLORS[track_id % len(_COLORS)]

COCO_NAMES = [
    "person","bicycle","car","motorcycle","airplane","bus","train","truck","boat",
    "traffic light","fire hydrant","stop sign","parking meter","bench","bird","cat",
    "dog","horse","sheep","cow","elephant","bear","zebra","giraffe","backpack",
    "umbrella","handbag","tie","suitcase","frisbee","skis","snowboard","sports ball",
    "kite","baseball bat","baseball glove","skateboard","surfboard","tennis racket",
    "bottle","wine glass","cup","fork","knife","spoon","bowl","banana","apple",
    "sandwich","orange","broccoli","carrot","hot dog","pizza","donut","cake","chair",
    "couch","potted plant","bed","dining table","toilet","tv","laptop","mouse",
    "remote","keyboard","cell phone","microwave","oven","toaster","sink",
    "refrigerator","book","clock","vase","scissors","teddy bear","hair drier",
    "toothbrush"
]

def iou_xyxy(a, b):
    ax1, ay1, ax2, ay2 = a
    bx1, by1, bx2, by2 = b

    inter_x1 = max(ax1, bx1)
    inter_y1 = max(ay1, by1)
    inter_x2 = min(ax2, bx2)
    inter_y2 = min(ay2, by2)

    inter_w = max(0, inter_x2 - inter_x1)
    inter_h = max(0, inter_y2 - inter_y1)
    inter = inter_w * inter_h

    area_a = max(0, ax2 - ax1) * max(0, ay2 - ay1)
    area_b = max(0, bx2 - bx1) * max(0, by2 - by1)
    union = area_a + area_b - inter + 1e-6

    return inter / union

def draw_tracks(frame, tracks):
    if tracks is None or len(tracks) == 0:
        return
    for t in tracks:
        x1, y1, x2, y2 = int(t[0]), int(t[1]), int(t[2]), int(t[3])
        tid = int(t[4])
        # boxmot ByteTrack output is usually:
        # [x1, y1, x2, y2, track_id, conf, cls, ...]
        cls = int(t[6]) if len(t) > 6 else -1
        c = _color(tid)
        name = COCO_NAMES[cls] if 0 <= cls < len(COCO_NAMES) else str(cls)
        label = f"{name} #{tid}"
        cv2.rectangle(frame, (x1, y1), (x2, y2), c, 2)
        cv2.putText(frame, label, (x1, y1-6),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, c, 1, cv2.LINE_AA)

def draw_faces(frame, faces, labels):
    for (x1,y1,x2,y2,_), label in zip(faces, labels):
        cv2.rectangle(frame, (x1,y1), (x2,y2), (255,200,0), 2)
        cv2.putText(frame, label, (x1, y1-6),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.45, (255,200,0), 1, cv2.LINE_AA)

def draw_anomaly(frame, score: float):
    if score > CFG["anomaly_thresh"]:
        cv2.putText(frame, f"ANOMALY {score:.2f}", (10, 30),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0,0,255), 2, cv2.LINE_AA)

# ─────────────────────────── MAIN LOOP ────────────────────────────────────────
def run(cfg: dict):
    # Start services
    threading.Thread(target=_mqtt_worker, args=(cfg,), daemon=True).start()
    mjpeg_srv = start_mjpeg(cfg["mjpeg_port"])

    # Load models
    yolo      = load_yolo(cfg["yolo_engine"])
    tracker   = _init_bytetrack()
    face_det  = None
    face_emb  = None
    watchlist = None
    patchcore = None
    yamnet    = None
    zones     = ZoneEngine(cfg["zones"])

    # Audio thread (independent of video)
    # start_audio_thread(yamnet, cfg["camera_id"], cfg)  # disabled for first laptop test

    cam = open_camera(cfg["rtsp_url"])

    running   = True
    n_frame   = 0
    last_infer = 0.0
    infer_gap  = 1.0 / max(cfg["inference_fps"], 1.0)
    last_tracks = np.empty((0, 6))
    last_faces:  list = []
    last_labels: list = []
    last_anomaly = 0.0
    last_summary_counts = {}
    last_summary_ts = 0.0

    # detection event deduplication
    alert_cooldown_sec = 30.0     # resend only after long time
    object_ttl_sec = 20.0          # object considered gone after this long
    next_object_id = 1
    active_objects = {}           # key -> {"cls":..., "bbox":..., "last_seen":..., "last_alert":...}

    # detection alert cooldown to avoid MQTT/DB/UI spam
    detection_alert_cooldown = 5.0
    last_detection_alert = {}

    def _stop(sig, _):
        nonlocal running; running = False
    signal.signal(signal.SIGINT, _stop)
    signal.signal(signal.SIGTERM, _stop)

    log.info("Pipeline running")

    try:
        while running:
            # 🔥 drop stale frames (critical for low latency)
            for _ in range(3):
                cam.grab()

            ret, raw = cam.read()
            if not ret or raw is None:
                # if video file → loop
                if str(cfg["rtsp_url"]).endswith((".mp4", ".webm", ".avi", ".mkv")):
                    log.info("End of video → restarting from beginning")
                    cam.release()
                    cam = open_camera(cfg["rtsp_url"])
                    continue
                # if real camera → reconnect
                log.warning("Camera read failed — reconnecting")
                cam.release()
                cam = reopen_camera(cfg["rtsp_url"], cfg["reconnect_delay"])
                continue

            frame = cv2.resize(raw, (cfg["resize_w"], cfg["resize_h"]))
            n_frame += 1
            now = time.time()

            # ── DETECTION + TRACKING (every frame at target fps) ──────────────
            if now - last_infer >= infer_gap:
                results = yolo(
                    frame,
                    conf=cfg["yolo_conf"],
                    device=DEVICE,
                    verbose=False,
                )
                last_infer = now

                # Convert to boxmot format: [[x1,y1,x2,y2,conf,cls], ...]
                dets = []
                for r in results:
                    if r.boxes is None:
                        continue
                    for b in r.boxes:
                        x1, y1, x2, y2 = b.xyxy[0].tolist()
                        cls = int(b.cls[0]) if b.cls is not None else 0
                        if cls not in ALLOWED_CLASSES:
                            continue
                        dets.append([x1, y1, x2, y2, float(b.conf[0]), cls])

                dets = np.array(dets, dtype=np.float32) if dets else np.empty((0,6))

                if tracker is not None:
                    last_tracks = tracker.update(dets, frame)
                else:
                    last_tracks = dets

                # scene summary event (human-friendly)
                # count objects
                                # scene summary event (human-friendly)
                class_counts = {}

                for t in last_tracks:
                    if tracker is not None and len(t) > 6:
                        # tracker output: [x1, y1, x2, y2, track_id, conf, cls, ...]
                        cls = int(t[6])
                    else:
                        # raw detection fallback: [x1, y1, x2, y2, conf, cls]
                        cls = int(t[5]) if len(t) > 5 else -1

                    if 0 <= cls < len(COCO_NAMES):
                        name = COCO_NAMES[cls]
                        class_counts[name] = class_counts.get(name, 0) + 1

                # send summary event (every 5 seconds)
                if class_counts != last_summary_counts:
                    parts = []
                    for name, count in class_counts.items():
                        if name == "person":
                            parts.append(f"{count} people" if count > 1 else "1 person")
                        else:
                            parts.append(f"{count} {name}s")

                    label = ", ".join(parts) + " detected"

                    emit_alert(cfg["camera_id"], "detection_summary", {
                        "counts": class_counts,
                        "label": label,
                        "severity": "medium"
                    })

                    last_summary_counts = dict(class_counts)
                    last_summary_counts = dict(class_counts)
                    last_summary_ts = time.time()
                # prune disappeared objects
                stale_keys = [
                    k for k, v in active_objects.items()
                    if now - v["last_seen"] > object_ttl_sec
                ]
                for k in stale_keys:
                    active_objects.pop(k, None)

                # Zone dwell + detection events with deduplication
                for t in last_tracks:
                    x1, y1, x2, y2 = int(t[0]), int(t[1]), int(t[2]), int(t[3])
                    bbox = [x1, y1, x2, y2]

                    # tracker output: [x1, y1, x2, y2, track_id, conf, cls, ...]
                    if tracker is not None and len(t) > 6:
                        track_id = int(t[4])
                        conf = float(t[5])
                        cls = int(t[6])
                        object_key = f"trk:{track_id}:{cls}"
                    else:
                        # fallback when tracking is disabled:
                        # match same class by IoU against active objects
                        conf = float(t[4]) if len(t) > 4 else 0.0
                        cls = int(t[5]) if len(t) > 5 else -1
                        track_id = -1

                        matched_key = None
                        best_iou = 0.0
                        for k, v in active_objects.items():
                            if v["cls"] != cls:
                                continue
                            score = iou_xyxy(bbox, v["bbox"])
                            if score > 0.50 and score > best_iou:
                                matched_key = k
                                best_iou = score

                        if matched_key is not None:
                            object_key = matched_key
                        else:
                            object_key = f"obj:{next_object_id}:{cls}"
                            next_object_id += 1

                    cx = int((x1 + x2) / 2)
                    cy = int((y1 + y2) / 2)
                    zones.update(track_id if track_id >= 0 else 0, cx, cy, cfg["camera_id"])

                    if not (0 <= cls < len(COCO_NAMES)):
                        continue

                    class_name = COCO_NAMES[cls]

                    info = active_objects.get(object_key)
                    is_new = info is None

                    if is_new:
                        info = {
                            "cls": cls,
                            "bbox": bbox,
                            "last_seen": now,
                            "last_alert": 0.0,
                        }
                        active_objects[object_key] = info

                    # update object state
                    info["bbox"] = bbox
                    info["last_seen"] = now

                    # alert only when object first appears, or after long cooldown
                    should_alert = is_new or (now - info["last_alert"] >= alert_cooldown_sec)

                    if should_alert:
                        emit_alert(cfg["camera_id"], "detection", {
                            "class_name": class_name,
                            "confidence": round(conf, 3),
                            "bbox": bbox,
                            "track_id": track_id if track_id >= 0 else None,
                            "label": f"{class_name} detected",
                            "severity": "medium" if class_name == "person" else "low"
                        })
                        info["last_alert"] = now

            # ── FACE DETECT + EMBED (every Nth detection frame) ───────────────
            # face disabled on Jetson first pass
            # ── ANOMALY SCORE (every ~1 s) ────────────────────────────────────
            # anomaly disabled on Jetson first pass
            # ── ANNOTATE + STREAM ─────────────────────────────────────────────
            vis = frame.copy()
            draw_tracks(vis, last_tracks)
            draw_faces(vis, last_faces, last_labels)
            draw_anomaly(vis, last_anomaly)

            ok, jpg = cv2.imencode(".jpg", vis,
                                   [cv2.IMWRITE_JPEG_QUALITY, cfg["mjpeg_quality"]])
            if ok:
                _frame_bus.put(jpg.tobytes())

            time.sleep(0.001)   # yield — keeps CPU free for sub-threads

    finally:
        cam.release()
        mjpeg_srv.shutdown(); mjpeg_srv.server_close()
        log.info("Pipeline stopped")


def main():
    run(CFG)

if __name__ == "__main__":
    main()
